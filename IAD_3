        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.model_selection import train_test_split, GridSearchCV\n",
        "from sklearn.tree import DecisionTreeClassifier, plot_tree\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    confusion_matrix,\n",
        "    ConfusionMatrixDisplay\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 1. ЗАВАНТАЖЕННЯ ТА ПІДГОТОВКА ДАНИХ\n",
        "# ==========================================\n",
        "# Переконайтеся, що файл heart.xlsx завантажено у панель файлів Google Colab\n",
        "df = pd.read_excel('heart.xlsx')\n",
        "\n",
        "features = ['sex', 'cp', 'fbs', 'restecg', 'exang']\n",
        "X = df[features]\n",
        "y = df['target']\n",
        "\n",
        "# Розбиття на навчальну та тестову вибірки (70% / 30%, стратифікація)\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.3, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "print(f\"Розмір навчальної вибірки: {X_train.shape[0]} спостережень\")\n",
        "print(f\"Розмір тестової вибірки: {X_test.shape[0]} спостережень\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# 2. БАЗОВЕ ДЕРЕВО РІШЕНЬ\n",
        "# ==========================================\n",
        "base_clf = DecisionTreeClassifier(criterion='entropy', random_state=42)\n",
        "base_clf.fit(X_train, y_train)\n",
        "\n",
        "y_pred_base = base_clf.predict(X_test)\n",
        "\n",
        "print(\"=== Базове дерево рішень ===\")\n",
        "print(f\"Глибина дерева: {base_clf.get_depth()}\")\n",
        "print(f\"Кількість кінцевих листків: {base_clf.get_n_leaves()}\")\n",
        "print(f\"Accuracy:  {accuracy_score(y_test, y_pred_base):.4f}\")\n",
        "print(f\"Precision: {precision_score(y_test, y_pred_base):.4f}\")\n",
        "print(f\"Recall:    {recall_score(y_test, y_pred_base):.4f}\")\n",
        "print(f\"F1-score:  {f1_score(y_test, y_pred_base):.4f}\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# 3. КРОС-ВАЛІДАЦІЯ ТА РЕГУЛЯРИЗАЦІЯ (CV=5)\n",
        "# ==========================================\n",
        "param_grid = {'min_samples_split': range(2, 51)}\n",
        "grid_search = GridSearchCV(\n",
        "    estimator=DecisionTreeClassifier(criterion='entropy', random_state=42),\n",
        "    param_grid=param_grid,\n",
        "    cv=5,\n",
        "    scoring='accuracy'\n",
        ")\n",
        "grid_search.fit(X_train, y_train)\n",
        "\n",
        "best_min_samples_split = grid_search.best_params_['min_samples_split']\n",
        "best_cv_accuracy = grid_search.best_score_\n",
        "best_cv_error = 1 - best_cv_accuracy\n",
        "\n",
        "print(\"=== Результати крос-валідації (CV=5) ===\")\n",
        "print(f\"Оптимальне min_samples_split: {best_min_samples_split}\")\n",
        "print(f\"Найкраща CV Accuracy: {best_cv_accuracy:.4f} (CV Error: {best_cv_error:.4f})\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# 4. ОПТИМІЗОВАНЕ (ОБРІЗАНЕ) ДЕРЕВО РІШЕНЬ\n",
        "# ==========================================\n",
        "optimized_clf = DecisionTreeClassifier(\n",
        "    criterion='entropy',\n",
        "    min_samples_split=best_min_samples_split,\n",
        "    random_state=42\n",
        ")\n",
        "optimized_clf.fit(X_train, y_train)\n",
        "\n",
        "y_pred_opt = optimized_clf.predict(X_test)\n",
        "cm_opt = confusion_matrix(y_test, y_pred_opt)\n",
        "\n",
        "print(\"=== Оптимізоване (обрізане) дерево рішень ===\")\n",
        "print(f\"Кількість кінцевих листків: {optimized_clf.get_n_leaves()}\")\n",
        "print(f\"Accuracy:  {accuracy_score(y_test, y_pred_opt):.4f}\")\n",
        "print(f\"Recall:    {recall_score(y_test, y_pred_opt):.4f}\")\n",
        "print(f\"F1-score:  {f1_score(y_test, y_pred_opt):.4f}\")\n",
        "print(\"Матриця невідповідностей (Confusion Matrix):\")\n",
        "print(cm_opt)\n",
        "\n",
        "# ==========================================\n",
        "# 5. ВІЗУАЛІЗАЦІЯ (З ОПТИМІЗОВАНИМИ РОЗМІРАМИ)\n",
        "# ==========================================\n",
        "\n",
        "# А. Графік залежності помилки крос-валідації (зручний компактний розмір)\n",
        "split_values = list(range(2, 51))\n",
        "cv_errors = [1 - score for score in grid_search.cv_results_['mean_test_score']]\n",
        "\n",
        "plt.figure(figsize=(9, 4.5), dpi=100)\n",
        "plt.plot(\n",
        "    split_values, cv_errors,\n",
        "    marker='o', markersize=4, color='#1f77b4',\n",
        "    label='Помилка крос-валідації (1 - Accuracy)'\n",
        ")\n",
        "plt.axvline(x=best_min_samples_split, color='#d62728', linestyle='--', alpha=0.7)\n",
        "plt.scatter(\n",
        "    [best_min_samples_split], [best_cv_error],\n",
        "    color='#d62728', s=70, zorder=5,\n",
        "    label=f'Оптимум: min_samples_split={best_min_samples_split} (Err={best_cv_error:.4f})'\n",
        ")\n",
        "plt.title('Залежність помилки крос-валідації від параметра min_samples_split', fontsize=11)\n",
        "plt.xlabel('Мінімальна кількість зразків для розщеплення (min_samples_split)', fontsize=9)\n",
        "plt.ylabel('Помилка крос-валідації (CV Error)', fontsize=9)\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
        "plt.legend(loc='upper right', fontsize=9)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Б. Візуалізація структури оптимізованого дерева (зменшена і збалансована ширина)\n",
        "plt.figure(figsize=(14, 7), dpi=100)\n",
        "plot_tree(\n",
        "    optimized_clf,\n",
        "    feature_names=features,\n",
        "    class_names=['Здоровий (0)', 'Хворий (1)'],\n",
        "    filled=True,\n",
        "    rounded=True,\n",
        "    fontsize=9\n",
        ")\n",
        "plt.title(f\"Оптимізоване дерево рішень (min_samples_split={best_min_samples_split})\", fontsize=12)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# В. Порівняльні теплові карти матриць невідповідностей (компактні)\n",
        "fig, axes = plt.subplots(1, 2, figsize=(10, 4), dpi=100)\n",
        "\n",
        "ConfusionMatrixDisplay.from_estimator(\n",
        "    base_clf, X_test, y_test,\n",
        "    display_labels=['Здоровий', 'Хворий'],\n",
        "    cmap=plt.cm.Blues,\n",
        "    ax=axes[0]\n",
        ")\n",
        "axes[0].set_title(f\"Базове дерево рішень\\n({base_clf.get_n_leaves()} листків)\", fontsize=10)\n",
        "\n",
        "ConfusionMatrixDisplay.from_estimator(\n",
        "    optimized_clf, X_test, y_test,\n",
        "    display_labels=['Здоровий', 'Хворий'],\n",
        "    cmap=plt.cm.Blues,\n",
        "    ax=axes[1]\n",
        ")\n",
        "axes[1].set_title(f\"Оптимізоване дерево рішень\\n({optimized_clf.get_n_leaves()} листків, min_samples_split={best_min_samples_split})\", fontsize=10)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
