      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import scipy.stats as stats\n",
        "import seaborn as sns\n",
        "import statsmodels.api as sm\n",
        "from statsmodels.formula.api import ols\n",
        "\n",
        "# --- 1. ЗАВАНТАЖЕННЯ ДАНИХ (Власний набір Tips) ---\n",
        "df_tips = sns.load_dataset(\"tips\")\n",
        "\n",
        "print(\"=== ПЕРШІ РЯДКИ ДАТАСЕТУ TIPS ===\")\n",
        "display(df_tips.head())\n",
        "print(\"-\" * 50)\n",
        "\n",
        "# --- 2. ПЕРЕВІРКА ГОМОГЕННОСТІ ДИСПЕРСІЙ (Тест Левена) ---\n",
        "# Групуємо суми чеків за днями тижня\n",
        "groups = [group[\"total_bill\"].values for name, group in df_tips.groupby(\"day\")]\n",
        "levene_stat, levene_p = stats.levene(*groups)\n",
        "\n",
        "print(f\"📊 Тест Левена: W = {levene_stat:.3f}, p-value = {levene_p:.3f}\")\n",
        "if levene_p > 0.05:\n",
        "    print(\"✅ Дисперсії гомогенні (умови ANOVA виконуються).\\n\")\n",
        "else:\n",
        "    print(\"⚠️ Дисперсії неоднорідні.\\n\")\n",
        "\n",
        "# --- 3. ОДНОФАКТОРНИЙ ANOVA ---\n",
        "model_tips = ols(\"total_bill ~ C(day)\", data=df_tips).fit()\n",
        "anova_tips = sm.stats.anova_lm(model_tips, typ=2)\n",
        "\n",
        "print(\"📊 Таблиця ANOVA для набору Tips:\")\n",
        "print(anova_tips)\n",
        "print(\"-\" * 50)\n",
        "\n",
        "# --- 4. ПОБУДОВА ДІАГРАМИ (Boxplot + Stripplot) ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.boxplot(\n",
        "    x=\"day\",\n",
        "    y=\"total_bill\",\n",
        "    data=df_tips,\n",
        "    hue=\"day\",\n",
        "    palette=\"Set2\",\n",
        "    legend=False,\n",
        "    order=[\"Thur\", \"Fri\", \"Sat\", \"Sun\"],\n",
        ")\n",
        "sns.stripplot(\n",
        "    x=\"day\",\n",
        "    y=\"total_bill\",\n",
        "    data=df_tips,\n",
        "    color=\"black\",\n",
        "    alpha=0.3,\n",
        "    jitter=0.2,\n",
        "    size=5,\n",
        "    order=[\"Thur\", \"Fri\", \"Sat\", \"Sun\"],\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Вплив дня тижня на загальну суму чека (Tips Dataset, One-Way ANOVA)\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\",\n",
        "    pad=15,\n",
        ")\n",
        "plt.xlabel(\"День тижня (day)\", fontsize=12)\n",
        "plt.ylabel(\"Загальна сума чека (total_bill, дол.)\", fontsize=12)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
