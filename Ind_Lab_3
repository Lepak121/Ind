        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import scipy.stats as stats\n",
        "import seaborn as sns\n",
        "\n",
        "# Налаштування стилю графіків\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.rcParams[\"figure.figsize\"] = (10, 6)\n",
        "\n",
        "# ==========================================\n",
        "# ЗАВДАННЯ 1: Аналіз набору даних anaconda.dat\n",
        "# ==========================================\n",
        "print(\"=== ЗАВДАННЯ 1: АНАЛІЗ БІОМЕТРИЧНИХ ДАНИХ АНАКОНД ===\")\n",
        "\n",
        "try:\n",
        "  df_anaconda = pd.read_csv(\"anaconda.dat\", delim_whitespace=True)\n",
        "except:\n",
        "  # Генерація демо-даних, якщо файл безпосередньо не завантажений у сесію\n",
        "  np.random.seed(42)\n",
        "  length = np.random.normal(250, 35, 56)\n",
        "  weight = 0.08 * (length**1.6) + np.random.normal(0, 4, 56)\n",
        "  gender = np.random.choice([0, 1], 56)\n",
        "  df_anaconda = pd.DataFrame(\n",
        "      {\"Length\": length, \"Weight\": weight, \"Gender\": gender}\n",
        "  )\n",
        "  print(\n",
        "      \"ℹ️ Увага: Використовуються демонстраційні дані анаконд для тестування.\"\n",
        "  )\n",
        "\n",
        "x_col = df_anaconda.columns[0]  # Довжина (X)\n",
        "y_col = df_anaconda.columns[1]  # Маса (Y)\n",
        "\n",
        "X = df_anaconda[x_col]\n",
        "Y = df_anaconda[y_col]\n",
        "\n",
        "# Статистичні розрахунки\n",
        "corr_pearson, p_value = stats.pearsonr(X, Y)\n",
        "slope, intercept, r_value, p_val, std_err = stats.linregress(X, Y)\n",
        "r_squared = r_value**2\n",
        "y_pred = slope * X + intercept\n",
        "residuals = Y - y_pred\n",
        "mse = np.mean(residuals**2)\n",
        "rmse = np.sqrt(mse)\n",
        "shapiro_stat, shapiro_p = stats.shapiro(residuals)\n",
        "\n",
        "print(f\"📊 Коефіцієнт кореляції Пірсона (r): {corr_pearson:.4f}\")\n",
        "print(f\"📐 Рівняння регресії: Y = {slope:.4f} * X + {intercept:.4f}\")\n",
        "print(f\"📈 Коефіцієнт детермінації (R^2): {r_squared:.4f}\")\n",
        "print(f\"📉 MSE: {mse:.4f} | RMSE: {rmse:.4f}\")\n",
        "print(f\"🔍 Критерій Шапіро-Уїлка (залишки): W = {shapiro_stat:.4f}, p-value = {shapiro_p:.4e}\\n\")\n",
        "\n",
        "# --- ГРАФІК 1: Емпіричні дані та лінія регресії ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(x=X, y=Y, color=\"forestgreen\", s=70, label=\"Дані анаконд\")\n",
        "plt.plot(\n",
        "    X,\n",
        "    y_pred,\n",
        "    color=\"crimson\",\n",
        "    linewidth=2.5,\n",
        "    label=f\"Регресія: Y = {slope:.2f}X {intercept:.2f}\",\n",
        ")\n",
        "plt.title(\n",
        "    \"Графік емпіричних даних та підігнаної прямої регресії\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\",\n",
        ")\n",
        "plt.xlabel(\"Довжина тіла X (см)\", fontsize=12)\n",
        "plt.ylabel(\"Маса тіла Y (кг)\", fontsize=12)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --- ГРАФІК 2: Діагностика залишків (Residuals vs Predictor X) ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(x=X, y=residuals, color=\"darkorange\", s=70)\n",
        "plt.axhline(0, color=\"black\", linestyle=\"--\", linewidth=1.5)\n",
        "plt.title(\n",
        "    \"Діагностика залишків: Residuals vs Predictor X (Гетероскедастичність)\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\",\n",
        ")\n",
        "plt.xlabel(\"Довжина тіла X (см)\", fontsize=12)\n",
        "plt.ylabel(\"Залишки (Residuals)\", fontsize=12)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --- ГРАФІК 3: Гістограма розподілу залишків ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.histplot(residuals, kde=True, color=\"teal\", bins=12, edgecolor=\"black\")\n",
        "plt.title(\n",
        "    \"Гістограма розподілу залишків (оцінка нормальності)\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\",\n",
        ")\n",
        "plt.xlabel(\"Значення залишків\", fontsize=12)\n",
        "plt.ylabel(\"Частота\", fontsize=12)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"=\" * 60 + \"\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# ЗАВДАННЯ 2: Аналіз набору Advertising.csv\n",
        "# ==========================================\n",
        "print(\"=== ЗАВДАННЯ 2: АНАЛІЗ ЕФЕКТИВНОСТІ РЕКЛАМИ (ADVERTISING) ===\")\n",
        "\n",
        "try:\n",
        "  df_adv = pd.read_csv(\"Advertising.csv\")\n",
        "except:\n",
        "  # Генерація демо-даних, якщо файл відсутній\n",
        "  np.random.seed(42)\n",
        "  tv = np.random.uniform(10, 300, 200)\n",
        "  sales = 0.0475 * tv + 7.03 + np.random.normal(0, 3.24, 200)\n",
        "  df_adv = pd.DataFrame({\"TV\": tv, \"Sales\": sales})\n",
        "  print(\n",
        "      \"ℹ️ Увага: Використовуються демонстраційні дані Advertising для тестування.\"\n",
        "  )\n",
        "\n",
        "# Автоматичний пошук стовпчиків\n",
        "tv_col = [c for c in df_adv.columns if \"tv\" in c.lower()][0]\n",
        "sales_col = [\n",
        "    c for c in df_adv.columns if \"sales\" in c.lower() or \"sale\" in c.lower()\n",
        "][0]\n",
        "\n",
        "X_adv = df_adv[tv_col]\n",
        "Y_adv = df_adv[sales_col]\n",
        "\n",
        "corr_adv, p_adv = stats.pearsonr(X_adv, Y_adv)\n",
        "slope_adv, intercept_adv, r_val_adv, _, _ = stats.linregress(X_adv, Y_adv)\n",
        "r2_adv = r_val_adv**2\n",
        "y_pred_adv = slope_adv * X_adv + intercept_adv\n",
        "mse_adv = np.mean((Y_adv - y_pred_adv) ** 2)\n",
        "rmse_adv = np.sqrt(mse_adv)\n",
        "\n",
        "print(\n",
        "    f\"📊 Коефіцієнт кореляції Пірсона (TV vs Sales): {corr_adv:.4f} (p-value:\"\n",
        "    f\" {p_adv:.4e})\"\n",
        ")\n",
        "print(\n",
        "    \"📐 Рівняння регресії:\"\n",
        "    f\" {sales_col} = {slope_adv:.4f} * {tv_col} + {intercept_adv:.2f}\"\n",
        ")\n",
        "print(f\"📈 Коефіцієнт детермінації (R^2): {r2_adv:.4f}\")\n",
        "print(f\"📉 MSE: {mse_adv:.4f} | RMSE: {rmse_adv:.4f}\\n\")\n",
        "\n",
        "# --- ГРАФІК ДЛЯ ADVERTISING ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(x=X_adv, y=Y_adv, color=\"dodgerblue\", s=60, label=\"Дані спостережень\")\n",
        "plt.plot(\n",
        "    X_adv,\n",
        "    y_pred_adv,\n",
        "    color=\"crimson\",\n",
        "    linewidth=2,\n",
        "    label=f\"Регресія: Sales = {slope_adv:.3f}*TV + {intercept_adv:.2f}\",\n",
        ")\n",
        "plt.title(\n",
        "    \"Залежність обсягу продажів від витрат на TV-рекламу\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\",\n",
        ")\n",
        "plt.xlabel(\"Витрати на TV-рекламу (тис. дол.)\", fontsize=12)\n",
        "plt.ylabel(\"Обсяг продажів (тис. од.)\", fontsize=12)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
