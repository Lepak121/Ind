        "print(\"=== 2. ДВОФАКТОРНИЙ ANOVA ДЛЯ RAT.TXT ===\")\n",
        "\n",
        "df_rat = pd.read_csv(\"rat.txt\", sep=r\"\\s+\")\n",
        "print(\"Перші рядки rat.txt:\")\n",
        "display(df_rat.head())\n",
        "print(\"-\" * 50)\n",
        "\n",
        "model_rat = ols(\n",
        "    \"ERRORS ~ C(ENVIRNMNT) + C(STRAIN) + C(ENVIRNMNT):C(STRAIN)\",\n",
        "    data=df_rat,\n",
        ").fit()\n",
        "anova_rat = sm.stats.anova_lm(model_rat, typ=2)\n",
        "\n",
        "print(\"📊 Таблиця двофакторного дисперсійного аналізу (ANOVA):\")\n",
        "print(anova_rat)\n",
